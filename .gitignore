# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Temporary & Environment / OS files
.DS_Store
Thumbs.db
*.tmp
*.log
.env
venv/
.venv/

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Client downloaded files (preserve folder structure with .gitkeep)
client/downloads/*
!client/downloads/.gitkeep

# LaTeX build artifacts (keep output PDFs in docs/)
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out
